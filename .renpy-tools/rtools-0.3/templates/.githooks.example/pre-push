#!/bin/sh

# Get the root directory of the git repository
PROJECT_DIR="$(git rev-parse --show-toplevel)"

echo ""
echo "========================================================"
echo "⚡ Running Pre-Push Hooks (Lint & Tests) before push..."
echo "========================================================"
echo ""

# 1. Run custom static analysis checkers (Asset integrity & Save/Rollback bug detector)
echo "🔍 Running: python manage.py check"
python "$PROJECT_DIR/manage.py" check
CHECK_EXIT=$?
if [ $CHECK_EXIT -ne 0 ]; then
    echo ""
    echo "❌ [Pre-Push Error] Ren'Py Static Checks failed with exit code $CHECK_EXIT."
    echo "❌ Git push has been aborted."
    echo "💡 You can bypass this check in emergencies with: git push --no-verify"
    echo "========================================================"
    exit 1
fi

# 2. Run Ren'Py built-in static analysis (lint)
echo "🔍 Running: python manage.py lint"
python "$PROJECT_DIR/manage.py" lint
LINT_EXIT=$?
if [ $LINT_EXIT -ne 0 ]; then
    echo ""
    echo "❌ [Pre-Push Error] Ren'Py Lint failed with exit code $LINT_EXIT."
    echo "❌ Git push has been aborted."
    echo "💡 You can bypass this check in emergencies with: git push --no-verify"
    echo "========================================================"
    exit 1
fi

# 3. Run automated tests
echo "🧪 Running: python manage.py test global"
python "$PROJECT_DIR/manage.py" test global
TEST_EXIT=$?
if [ $TEST_EXIT -ne 0 ]; then
    echo ""
    echo "❌ [Pre-Push Error] Unit tests failed with exit code $TEST_EXIT."
    echo "❌ Git push has been aborted."
    echo "💡 You can bypass this check in emergencies with: git push --no-verify"
    echo "========================================================"
    exit 1
fi

echo ""
echo "✅ [Pre-Push Success] All checks passed! Proceeding to push..."
echo "========================================================"
echo ""
exit 0
