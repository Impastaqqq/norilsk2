# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Krita temp files
/game/**/*.kra~
/game/**/*.png~
/game/**/*.jpg~
/game/**/*.kra-autosave.kra
/game/**/*.png-autosave.kra
/game/**/*.jpg-autosave.kra

# VSCode Ren'Py Warp library files
vscode_renpy_warp_*.rpe*

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# IDE configs
/.idea
/.vscode

# Temporary files
lint_output.txt
test_run.txt
test_run_cmd.txt

# Local environment variables
.env
/.env
__pycache__
/__pycache__
*.pyc
*.rpyc